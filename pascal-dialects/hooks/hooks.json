{
  "description": "Pascal 方言ガード。PreToolUse で方言のスキルを読んだか記録・確認し、PostToolUse で書いたソースをコンパイルする。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bb",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/pascal-guard.clj", "guard"],
            "timeout": 10,
            "statusMessage": "Pascal の方言を確認中..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bb",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/pascal-guard.clj", "verify"],
            "timeout": 60,
            "statusMessage": "Pascal ソースをコンパイル中..."
          }
        ]
      }
    ]
  }
}
